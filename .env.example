# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL (paste your existing connection details) ---
# Standard libpq names (PGDATABASE, PGUSER, ...) are also accepted.
POSTGRES_DB=grd-dev-3.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10
# Django creates its tables in the first schema (keep public first); the rest
# let unmanaged models in your domain schemas resolve unqualified.
POSTGRES_SEARCH_PATH=public,grd,grd_ref,grd_validation

# --- Auth / JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS (your Next.js origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DRF ---
DRF_PAGE_SIZE=25
