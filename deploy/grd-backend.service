# systemd unit for the gunicorn app server.
# Install:  sudo cp deploy/grd-backend.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now grd-backend
# Assumes the repo lives at /opt/grd_backend with a venv at /opt/grd_backend/.venv
# and a filled-in /opt/grd_backend/.env  (adjust paths/User below to match).

[Unit]
Description=grd_backend (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/grd_backend
EnvironmentFile=/opt/grd_backend/.env
RuntimeDirectory=grd-backend
RuntimeDirectoryMode=0755
ExecStart=/opt/grd_backend/.venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
