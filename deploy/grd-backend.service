# systemd unit for the gunicorn app server.
# Install:  sudo cp deploy/grd-backend.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now grd-backend
#
# Assumes:  repo at /home/webadm/grd_backend, venv at .venv, filled-in .env,
#           running as the webadm user. Adjust all four if your layout differs.

[Unit]
Description=grd_backend (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=webadm
Group=webadm
WorkingDirectory=/home/webadm/grd_backend
EnvironmentFile=/home/webadm/grd_backend/.env
RuntimeDirectory=grd-backend
RuntimeDirectoryMode=0755
ExecStart=/home/webadm/grd_backend/.venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Light hardening (kept loose because the app lives under /home)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
